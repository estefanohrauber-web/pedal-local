<?xml version="1.0" encoding="utf-8"?>
<!-- O Android bloqueia endereços http (sem s). Libera só o Home Assistant da casa, na rede local,
     para onde o app manda os pedais (Ajustes › Avançado › Enviar para o Home Assistant). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.3.70</domain>
    </domain-config>
</network-security-config>
